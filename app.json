{
  "name": "Lemma Enterprise",
  "description": "Human verification system using DID proofing and verifiable credentials with integrated OPRF functionality",
  "repository": "https://github.com/yourusername/lemma-enterprise",
  "keywords": ["python", "flask", "verifiable-credentials", "did", "oprf"],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "FLASK_APP": {
      "description": "Flask application entry point",
      "value": "wsgi.py"
    },
    "FLASK_ENV": {
      "description": "Flask environment",
      "value": "production"
    },
    "PYTHONUNBUFFERED": {
      "description": "Prevents Python from buffering stdout and stderr",
      "value": "1"
    },
    "WEB_CONCURRENCY": {
      "description": "Number of worker processes for Gunicorn",
      "value": "3"
    },
    "LEMMA_ADMIN_USER": {
      "description": "Admin username for Lemma Enterprise",
      "generator": "secret"
    },
    "LEMMA_ADMIN_PASS": {
      "description": "Admin password for Lemma Enterprise",
      "generator": "secret"
    },
    "LEMMA_SECRET_KEY": {
      "description": "Secret key for Flask sessions",
      "generator": "secret"
    },
    "LEMMA_API_KEY": {
      "description": "API key for Lemma Enterprise",
      "generator": "secret"
    },
    "DID": {
      "description": "Decentralized Identifier for the issuer",
      "value": "did:web:lemma.id"
    },
    "DID_METHOD": {
      "description": "DID method to use",
      "value": "web"
    },
    "OPRF_SERVICE_INTERNAL": {
      "description": "OPRF functionality integrated into main Flask app",
      "value": "true"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}