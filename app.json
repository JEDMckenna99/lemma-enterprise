{
  "name": "Lemma Enterprise",
  "description": "Human verification system using DID proofing and verifiable credentials",
  "repository": "https://github.com/yourusername/lemma-enterprise",
  "keywords": ["python", "flask", "go", "oprf", "verifiable-credentials", "did"],
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "heroku/go"
    }
  ],
  "env": {
    "FLASK_APP": {
      "description": "Flask application entry point",
      "value": "wsgi.py"
    },
    "FLASK_ENV": {
      "description": "Flask environment",
      "value": "production"
    },
    "PYTHONUNBUFFERED": {
      "description": "Prevents Python from buffering stdout and stderr",
      "value": "1"
    },
    "WEB_CONCURRENCY": {
      "description": "Number of worker processes for Gunicorn",
      "value": "3"
    },
    "LEMMA_ADMIN_USER": {
      "description": "Admin username for Lemma Enterprise",
      "generator": "secret"
    },
    "LEMMA_ADMIN_PASS": {
      "description": "Admin password for Lemma Enterprise",
      "generator": "secret"
    },
    "LEMMA_SECRET_KEY": {
      "description": "Secret key for Flask sessions",
      "generator": "secret"
    },
    "LEMMA_API_KEY": {
      "description": "API key for Lemma Enterprise",
      "generator": "secret"
    },
    "DID": {
      "description": "Decentralized Identifier for the issuer",
      "value": "did:web:lemma-enterprise.herokuapp.com"
    },
    "DID_METHOD": {
      "description": "DID method to use",
      "value": "web"
    },
    "OPRF_SERVICE_INTERNAL": {
      "description": "Enable internal OPRF service (true for production)",
      "value": "true"
    },
    "OPRF_RATE_LIMIT": {
      "description": "Rate limit for OPRF service (requests per minute)",
      "value": "60"
    },
    "OPRF_ROTATION_DAYS": {
      "description": "Days before OPRF key rotation",
      "value": "30"
    },
    "OPRF_DEBUG": {
      "description": "Enable debug mode for OPRF service",
      "value": "false"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "oprf": {
      "quantity": 1,
      "size": "basic"
    }
  }
}