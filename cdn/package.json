{
  "name": "lemma-cdn-build",
  "version": "1.0.0",
  "description": "CDN build tools for Lemma verification system",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "watch": "nodemon build.js",
    "clean": "rm -rf dist",
    "serve": "http-server dist -p 3000 -c-1",
    "test": "node -e \"require('./build.js'); console.log('Build completed successfully')\""
