{
  "name": "@lemma/verification-sdk",
  "version": "1.0.0",
  "description": "Lemma offline credential verification SDK for JavaScript and TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "typings": "src/lemma.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "examples/**/*",
    "README.md",
    "src/lemma.d.ts"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "dev": "rollup -c --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "jsdoc -c jsdoc.json",
    "docs:watch": "nodemon --watch src --ext ts,js,md --exec \"npm run docs\"",
    "type-docs": "typedoc src/index.ts --out docs/typedoc"
  },
  "keywords": [
    "lemma",
    "credential",
    "verification",
    "offline",
    "webassembly",
    "wasm",
    "qr-code",
    "identity",
    "authentication",
    "security",
    "cryptography"
  ],
  "author": "Lemma Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemma-verification/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/lemma-verification/sdk/issues"
  },
  "homepage": "https://lemma.id",
  "dependencies": {
    "qr-scanner": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@storybook/addon-essentials": "^7.5.0",
    "@storybook/addon-interactions": "^7.5.0",
    "@storybook/addon-links": "^7.5.0",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.5.0",
    "@storybook/html": "^7.5.0",
    "@storybook/html-vite": "^7.5.0",
    "@storybook/testing-library": "^0.2.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "rollup": "^4.1.4",
    "storybook": "^7.5.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.2",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
} 