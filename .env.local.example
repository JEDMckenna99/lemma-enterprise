# Local development config
# Copy to .env.local and fill values. This file is safe to commit.

SECRET_KEY=replace-with-local-random-secret
FLASK_ENV=development
ENVIRONMENT=local
PORT=5000
LEMMA_BASE_URL=http://localhost:5000

DATABASE_URL=postgresql://lemma:lemma@localhost:5432/lemma
REDIS_URL=redis://localhost:6379/0

LEMMA_PPID_ROOT_KEY=replace-with-local-random-32-byte-root-key

# Stripe test mode only for local.
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace
ISHUMAN_RETURN_URL=http://localhost:5000/demo/ishuman?verification_return=true

# Optional: lets /demo/ishuman complete a test-mode session without manual ID upload.
LEMMA_ISHUMAN_DEMO_ALLOW_TEST_VERIFY=true
LEMMA_ISHUMAN_DEMO_TEST_TOKEN=replace-with-local-demo-token
LEMMA_ISHUMAN_DEMO_ADMIN_TOKEN=replace-with-local-demo-admin-token

# Required if local signing should use the same KMS-backed issuer path as Heroku.
AWS_REGION=us-east-1
LEMMA_KMS_KEY_ID=replace-with-dev-or-staging-kms-key-id
