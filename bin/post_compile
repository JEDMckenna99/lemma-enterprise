#!/bin/bash

echo "🦀 HEROKU POST-COMPILE: Installing lemma-crypto Python package"
echo "=============================================================="

# Exit on any error  
set -e

# Environment setup
export BUILD_DIR=${BUILD_DIR:-$(pwd)}
export CACHE_DIR=${CACHE_DIR:-/tmp/cache}

echo "📍 Current directory: $(pwd)"
echo "📁 Build directory: $BUILD_DIR"

# Function to log with timestamp
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
}

log "🐍 Installing lemma-crypto Python package..."

# Navigate to lemma-crypto directory
cd "$BUILD_DIR/lemma-crypto"

# Check if the Rust build produced the necessary files
if [ -f "target/release/liblemma_crypto.so" ] || [ -f "target/release/liblemma_crypto.dylib" ] || [ -f "target/release/lemma_crypto.dll" ]; then
    log "✅ Rust library found in target/release/"
elif [ -d "target/release" ]; then
    log "📂 Contents of target/release/:"
    ls -la target/release/ || true
else
    log "⚠️  No target/release directory found"
fi

# Try to install using maturin (the proper tool for Rust-Python bindings)
if [ -f "pyproject.toml" ]; then
    log "📦 Installing with maturin using pyproject.toml..."
    
    # Install maturin if not available
    if ! command -v maturin &> /dev/null; then
        log "📥 Installing maturin..."
        pip install maturin
    fi
    
    # Build and install with maturin
    log "🔨 Building with maturin develop..."
    maturin develop --release --verbose
    
    if [ $? -eq 0 ]; then
        log "✅ lemma-crypto installed successfully with maturin"
        
        # Test the import
        python -c "import lemma_crypto; print('✅ lemma_crypto import successful')" || log "⚠️ Import test failed"
        
        # Create success marker
        touch "$BUILD_DIR/.lemma_crypto_success"
        log "✅ Success marker created"
    else
        log "❌ maturin develop failed, trying pip fallback..."
        
        # Fallback to pip install
        pip install -e . --verbose
        
        if [ $? -eq 0 ]; then
            log "✅ lemma-crypto installed successfully with pip fallback"
            python -c "import lemma_crypto; print('✅ lemma_crypto import successful')" || log "⚠️ Import test failed"
            touch "$BUILD_DIR/.lemma_crypto_success"
        else
            log "❌ Both maturin and pip install failed"
            exit 1
        fi
    fi
else
    log "❌ No pyproject.toml found for Python installation"
    exit 1
fi

log "🎉 lemma-crypto Python package installation complete" 