# Lemma Enterprise Production Environment Variables
# Copy this file to .env.production and fill in the values

# Flask settings
FLASK_APP=app.py
FLASK_ENV=production

# Security settings
LEMMA_ADMIN_USER=admin
LEMMA_ADMIN_PASS=CHANGE_ME_TO_SECURE_PASSWORD
LEMMA_API_KEY=CHANGE_ME_TO_SECURE_API_KEY
LEMMA_ADMIN_API_KEY=CHANGE_ME_TO_SECURE_ADMIN_API_KEY
LEMMA_SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY

# Storage settings
LEMMA_STORAGE_DIR=instance/data

# Security enhancements for production
LEMMA_DISABLE_MOCK_SERVICES=true
LEMMA_REQUIRE_HTTPS=true
LEMMA_STRICT_CSRF=true
LEMMA_STRICT_API_KEYS=true

# Optional: Stripe API key for identity verification
# STRIPE_API_KEY=sk_test_your_key_here 