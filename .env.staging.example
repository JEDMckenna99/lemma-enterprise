# Heroku staging config template
# Set these with `heroku config:set ... -a <staging-app>`.
# Use Stripe test mode and staging infrastructure only.

SECRET_KEY=replace-with-staging-random-secret
FLASK_ENV=production
ENVIRONMENT=staging
LEMMA_BASE_URL=https://<staging-app>.herokuapp.com

DATABASE_URL=managed-by-heroku-postgres
REDIS_URL=managed-by-heroku-redis

LEMMA_PPID_ROOT_KEY=replace-with-staging-random-32-byte-root-key

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace
ISHUMAN_RETURN_URL=https://<staging-app>.herokuapp.com/demo/ishuman?verification_return=true

LEMMA_ISHUMAN_DEMO_ALLOW_TEST_VERIFY=true
LEMMA_ISHUMAN_DEMO_TEST_TOKEN=replace-with-staging-demo-token
LEMMA_ISHUMAN_DEMO_ADMIN_TOKEN=replace-with-staging-demo-admin-token

AWS_REGION=us-east-1
LEMMA_KMS_KEY_ID=replace-with-staging-kms-key-id
