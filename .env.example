# Lemma.id environment template
#
# Copy one of the tier-specific examples instead of using this file directly:
# - .env.local.example -> .env.local
# - .env.staging.example -> Heroku staging config
# - .env.production.example -> Heroku production config
#
# Never commit real .env files or copied Heroku config snapshots.

SECRET_KEY=replace-with-random-32-byte-secret
FLASK_ENV=development
ENVIRONMENT=development
PORT=5000
LEMMA_BASE_URL=http://localhost:5000

DATABASE_URL=postgresql://lemma:lemma@localhost:5432/lemma
REDIS_URL=redis://localhost:6379/0

LEMMA_PPID_ROOT_KEY=replace-with-random-32-byte-ppid-root-key

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace
ISHUMAN_RETURN_URL=http://localhost:5000/demo/ishuman?verification_return=true

LEMMA_ISHUMAN_DEMO_ALLOW_TEST_VERIFY=false
LEMMA_ISHUMAN_DEMO_TEST_TOKEN=
LEMMA_ISHUMAN_DEMO_ADMIN_TOKEN=

AWS_REGION=us-east-1
LEMMA_KMS_KEY_ID=
