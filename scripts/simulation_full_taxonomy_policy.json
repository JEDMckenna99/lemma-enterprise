{
  "default_timeout_seconds": 15,
  "apis": {
    "httpbin": {
      "base_url": "https://httpbin.org",
      "allowed_methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "path_prefixes": ["/get", "/post", "/put", "/patch", "/delete", "/status/", "/headers", "/ip", "/anything"],
      "required_scope": "read",
      "risk_tier": "low",
      "forward_headers": ["content-type", "accept"]
    }
  }
}
