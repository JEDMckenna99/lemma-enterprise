                  "    pm.expect(response).to.have.property('cascade_size');",
                  "    pm.expect(response).to.have.property('last_updated');",
                  "});",
                  "",
                  "pm.test('Performance under 100ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(100);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/shield/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shield",
                "status"
              ]
            }
          }
        }
      ]
