                  "    pm.expect(response.success).to.eql(true);",
                  "    pm.expect(response).to.have.property('revocation_id');",
                  "    pm.globals.set('revocation_id', response.revocation_id);",
                  "});",
                  "",
                  "pm.test('Revocation under 4 seconds', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(4000);",
                  "});"
                ],
                "type": "text/javascript"
