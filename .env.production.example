# Heroku production config template
# Set these with `heroku config:set ... -a <production-app>`.
# Use live Stripe keys only in production.

SECRET_KEY=replace-with-production-random-secret
FLASK_ENV=production
ENVIRONMENT=production
LEMMA_BASE_URL=https://lemma.id

DATABASE_URL=managed-by-heroku-postgres
REDIS_URL=managed-by-heroku-redis

LEMMA_PPID_ROOT_KEY=replace-with-production-random-32-byte-root-key

STRIPE_SECRET_KEY=sk_live_replace
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_replace
ISHUMAN_RETURN_URL=https://lemma.id/demo/ishuman?verification_return=true

# Must stay disabled in production.
LEMMA_ISHUMAN_DEMO_ALLOW_TEST_VERIFY=false
LEMMA_ISHUMAN_DEMO_TEST_TOKEN=
LEMMA_ISHUMAN_DEMO_ADMIN_TOKEN=

AWS_REGION=us-east-1
LEMMA_KMS_KEY_ID=replace-with-production-kms-key-id
