# Lemma Enterprise Production Environment Template
# Copy this file to .env.production and fill in the values with your production credentials

# Admin credentials
LEMMA_ADMIN_USER=admin
LEMMA_ADMIN_PASS=REPLACE_WITH_STRONG_PASSWORD

# Application security
LEMMA_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_STRING

# Twilio SMS integration
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=False
