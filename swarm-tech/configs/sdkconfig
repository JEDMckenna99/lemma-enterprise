#
# ESP32 Configuration for Lemma Swarm Demo
# Optimized for Bluetooth Low Energy and cryptographic operations
#

#
# Bluetooth
#
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

#
# Bluetooth controller
#
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=n
CONFIG_BTDM_CTRL_HCI_MODE_VHCI=y
CONFIG_BTDM_CTRL_HCI_MODE_UART_H4=n

#
# BLE Security Configuration
#
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_SMP_ENABLE=y

#
# BLE Performance Optimization
#
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_BLE_HOST_QUEUE_CONG_CHECK=y
CONFIG_BT_BLE_ACT_SCAN_REP_ADV_SCAN=y
CONFIG_BT_BLE_RPA_SUPPORTED=y

#
# Memory Configuration for Crypto Operations
#
CONFIG_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

#
# Flash and Memory Optimization
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

#
# CPU and Performance
#
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32_SPIRAM_SUPPORT=n

#
# Security Features
#
CONFIG_SECURE_BOOT_ENABLED=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_ESP32_ENABLE_COREDUMP_TO_FLASH=n

#
# Compiler Optimization for Crypto
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=n
CONFIG_COMPILER_OPTIMIZATION_DEFAULT=n
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=n

#
# Hardware RNG for Cryptography
#
CONFIG_ESP32_RNG_ENABLE=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

#
# Serial Console Configuration
#
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

#
# Log Configuration for Development
#
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_VERBOSE=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=n
CONFIG_LOG_MAXIMUM_LEVEL=4

#
# FreeRTOS Configuration
#
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ASSERT_ON_UNTESTED_FUNCTION=n
CONFIG_FREERTOS_ASSERT_FAIL_ABORT=y

#
# Wi-Fi (Disabled to save memory for BLE)
#
CONFIG_ESP32_WIFI_ENABLED=n

#
# GPIO Configuration
#
CONFIG_GPIO_ESP32_SUPPORT_SWITCH_SLP_PULL=y

#
# Bootloader Configuration
#
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_DEBUG=n

#
# Application Level Tracing (Disabled for performance)
#
CONFIG_APPTRACE_ENABLE=n

#
# Power Management (Basic for demo)
#
CONFIG_PM_ENABLE=n

#
# Ethernet (Disabled)
#
CONFIG_ETH_USE_ESP32_EMAC=n

#
# CAN (Disabled)
#
CONFIG_CAN_ENABLED=n

#
# ADC (Disabled)
#
CONFIG_ADC_DISABLE_DAC=y

#
# SPI Flash driver
#
CONFIG_SPI_FLASH_WRITING_DANGEROUS_REGIONS_ABORTS=n
CONFIG_SPI_FLASH_WRITING_DANGEROUS_REGIONS_FAILS=y

#
# End of ESP32 Configuration for Lemma Swarm Demo
# 